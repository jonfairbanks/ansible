[Unit]
Description=Refresh Blink K3s Node-Reader Credential
After=k3s.service

[Service]
Type=oneshot
TimeoutStartSec=75
Restart=on-failure
RestartSec=30
ExecStart=/usr/bin/python3 /opt/blink-kube/refresh-credentials.py
User=root
Group=root
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/blink-kube
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_CHOWN
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
